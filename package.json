{
  "name": "agenda-local",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @agenda/web",
    "build": "npm run build -w @agenda/web",
    "lint": "npm run lint -w @agenda/web",
    "typecheck": "npm run typecheck -w @agenda/web",
    "test": "npm run test -w @agenda/web",
    "test:e2e": "npm run test:e2e -w @agenda/web",
    "seed": "node scripts/seed.mjs",
    "seed:clear": "node scripts/seed.mjs --clear"
  },
  "engines": {"node": ">=20.9"}
  ,
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  }
}
