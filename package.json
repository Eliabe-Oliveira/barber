{
  "name": "agenda-local",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --webpack apps/web",
    "start": "next start apps/web",
    "build": "next build apps/web",
    "lint": "eslint apps/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "seed": "node scripts/seed.mjs",
    "seed:clear": "node scripts/seed.mjs --clear"
  },
  "engines": {"node": ">=20.9"}
  ,
  "dependencies": {
    "next": "^16.2.11",
    "postcss": "^8.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.11",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
